# Database
POSTGRES_DB=beehive
POSTGRES_USER=bee
POSTGRES_PASSWORD=change-me

# Ports
DB_PORT=5432
APP_PORT=3000

# App connection to database (internal Docker network — for docker-compose.yml)
DATABASE_URL=postgresql://bee:change-me@db:5432/beehive

# Better Auth (runtime only — do not commit real values)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# LAN-only sign-up: CIDR range allowed to create accounts (e.g. 192.168.1.0/24).
# When unset or empty, sign-ups are blocked entirely (fails closed).
AUTH_SIGNUP_CIDR=192.168.1.0/24
