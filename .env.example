# Database
POSTGRES_DB=beehive
POSTGRES_USER=bee
POSTGRES_PASSWORD=change-me

# Ports
DB_PORT=5432
APP_PORT=3000

# App connection to database (internal Docker network — for docker-compose.yml)
DATABASE_URL=postgresql://bee:change-me@db:5432/beehive

# Better Auth (runtime only — do not commit real values)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Set to "true" to disable LAN-only sign-up restriction (local development)
DEV=
